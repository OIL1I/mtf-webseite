{
  "name": "mtf-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:init:local": "wrangler d1 execute mtf-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mtf-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply mtf-db --local && wrangler d1 execute mtf-db --local --file=./triggers.sql",
    "db:migrate:remote": "wrangler d1 migrations apply mtf-db --remote && wrangler d1 execute mtf-db --remote --file=./triggers.sql",
    "vapid": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@mtf/shared": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.0.0"
  }
}
